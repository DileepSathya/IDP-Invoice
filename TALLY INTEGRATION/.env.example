# Tally Bridge service environment
# Copy to .env in this folder (TALLY INTEGRATION/)

TALLY_URL=http://localhost:9000
TALLY_COMPANY=
TALLY_VOUCHER_TYPE=Purchase
# Default fallback when no ledger is saved in Settings -> Ledger Settings
TALLY_PURCHASE_LEDGER=Purchase A/c

MONGO_URI=mongodb://localhost:27017
MONGO_DB=IDP
MONGO_INVOICES_COLLECTION=invoices

# Bridge API port (when running uvicorn)
# TALLY_BRIDGE_PORT=8001


#mode=test