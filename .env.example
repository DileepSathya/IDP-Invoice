## Copy this file to `.env` and fill in values.
## Do NOT commit `.env`.
## GEMINI_API_KEY and AI_MODEL_PROVIDER can also be set from the app's
## account menu -> Settings -> AI agent pane; doing so writes them into this
## same .env file, so either way ends up here.

# Required
GEMINI_API_KEY=YOUR_KEY_HERE

# Which AI model the Settings UI has selected (currently only "gemini").
AI_MODEL_PROVIDER=gemini

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
#GEMINI_MODEL=gemini-3.5-flash
#GEMINI_MODEL=gemini-3.1-flash-lite

# Comma-separated fallback models tried immediately when the primary model fails
# (quota, overload, unavailable, etc.). Auth/key errors do not trigger fallback.
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite

# Prompt template. `{ocr_text}` will be replaced with OCR output.
GEMINI_PROMPT=Extract structured invoice data from the OCR text below.\n\nReturn STRICT JSON ONLY (no markdown, no explanations).\n\nRequired top-level keys (always include; use null if missing):\n- invoice_number\n- invoice_date\n- due_date\n- seller\n- buyer\n- address\n- bank_name\n- bank_address\n- account_number\n- account_holder_name\n- ifsc_code\n- total_amount\n- po_id (the Purchase Order number / PO number / Purchase ID, however it is labeled on the invoice; null if not present anywhere)\n- term_to_pay (the payment term / term of payment / net days, e.g. \"Net 30\", \"30 days\", \"60 days\"; null if not shown)\n\nLine items:\n- line_items: an array (can be empty [])\n- Each item must be its own NEW array element (do NOT embed multiple services/HSN in one string/object)\n- Each line item object keys (use null if missing):\n  - hsn_number\n  - service\n  - quantity (numeric quantity only, e.g. \"10\", without the unit of measure)\n  - unit (the unit of measure for quantity, e.g. \"nos\", \"units\", \"ltr\", \"kg\", \"pcs\", \"box\", \"mtr\", \"sqft\", \"hrs\"; null if not shown)\n  - price_per_unit (rate per single unit)\n  - amount (pre-tax amount; must equal quantity * price_per_unit when both are present)\n  - tax_rate\n  - tax_amount\n  - amount_after_tax\n\nRules:\n- If a field is not present return null\n- po_id may be labeled PO Number, Purchase Order, Purchase Order Number, Purchase ID, or similar - extract it under the single key po_id; if it genuinely is not shown anywhere on the invoice, return null rather than guessing (this will be flagged for human review)\n- term_to_pay may be labeled Term of Payment, Payment Terms, Net Days, or Credit Period, and typically looks like \"Net 30\", \"30 days\", or \"60 days\" - extract it under the single key term_to_pay; if not shown, return null (either term_to_pay or due_date being present is enough - if both are null the invoice will be flagged for human review)\n- Never guess quantity or price_per_unit: only fill them when the OCR text actually shows a value; otherwise return null so it can be reviewed\n- If there are multiple HSN numbers or services, create multiple objects inside line_items\n- Numbers can be strings if OCR is ambiguous, but must contain only the numeric value (no currency symbols, no unit text)\n- Ensure total_amount (top-level) equals the sum of every line item's amount_after_tax (or amount, if tax is not applicable) whenever the invoice supports that computation\n- If the invoice has a separate Billing Summary / Totals section (not per line item), extract those values into additional_fields using these exact keys when present: sub_total, discount, sgst_rate, sgst_amount, cgst_rate, cgst_amount, igst_rate, igst_amount, round_off\n- Do not extract the same discount/tax/round-off amount both inside a line item AND again in additional_fields - use whichever section (line items or billing summary) actually shows it on the invoice\n- Add any extra fields you find into: additional_fields (object). If none, use {}.\n- Output MUST be valid JSON\n\nOCR TEXT:\n{ocr_text}

# MongoDB (optional, defaults shown)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=IDP
MONGO_INVOICES_COLLECTION=invoices
MONGO_GEMINI_METRICS_COLLECTION=Gemini_metrics

# Invoice file lifecycle folders (optional — all relative to app install root)
TO_BE_PROCESSED_DIR=./invoices_data/to_be_processed
API_STAGING_DIR=./invoices_data/_api_staging
HITL_PENDING_DIR=./invoices_data/HITL_pending
ERROR_DIR=./invoices_data/ERROR
GEMINI_API_ERROR_DIR=./invoices_data/gemini_api_error
COMPLETED_DIR=./invoices_data/Completed

# Chatbot — Qdrant + embeddings for semantic search; structured MongoDB analytics;
# optional Gemini for natural-language answers when GEMINI_API_KEY is set
# Set CHAT_OFFLINE_ONLY=true to disable Gemini and answer fully offline
# CHAT_OFFLINE_ONLY=false
# GEMINI_CHAT_PROMPT=Answer using only this invoice context.\n\nContext:\n{context}\n\nQuestion: {question}

# Vector search backend: qdrant (default) or tfidf (legacy local fallback)
# CHAT_VECTOR_BACKEND=qdrant
# CHAT_EMBEDDING_PROVIDER=auto
# CHAT_EMBEDDING_PREFER_GEMINI=false
# CHAT_EMBEDDING_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# QDRANT_URL=
# QDRANT_PATH=
# QDRANT_COLLECTION=idp_invoices
# QDRANT_API_KEY=

# Portable / packaged app (optional)
IDP_API_PORT=8000
# Set to 0/false to skip bundled MongoDB and use your own server (e.g. Atlas)
IDP_USE_BUNDLED_MONGO=1

# ERP / PO_DB (PostgreSQL) — read-only reference data (vendor_master,
# item_master, po_header, po_details; see PO_DB/sql/create_po_database.sql) used to
# fuzzy-match each invoice's seller / line items / PO number and save vendor_id /
# item_id back onto the invoice. With the portable build, bundled PostgreSQL in
# po-db/ is used when POSTGRES_HOST=localhost (default). Clear POSTGRES_HOST to
# disable ERP matching entirely — the rest of the pipeline behaves exactly as before.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=PO_DB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Set to 0/false to use your own PostgreSQL server instead of po-db/pgsql/
IDP_USE_BUNDLED_POSTGRES=1
# po-db.exe auto-starts when PO_DB_WATCHER_ENABLED=true (creates DB/tables if missing)
PO_DB_WATCHER_ENABLED=true
# Score (0-100, via rapidfuzz) at/above which a vendor/item/PO match is auto-accepted;
# below this (or no candidate at all) the invoice is flagged for HITL with the reason.
ERP_MATCH_THRESHOLD=70

# Tally integration — bridge to TALLY INTEGRATION service (inventory voucher pipeline).
# Start the bridge: cd "TALLY INTEGRATION" && uvicorn api_server:app --port 8001
TALLY_ENABLED=false
TALLY_BRIDGE_URL=http://localhost:8001
TALLY_PUSH_ON_ERP_SYNC=true
# Bridge service .env (in TALLY INTEGRATION/ folder):
# TALLY_URL=http://localhost:9000
# TALLY_COMPANY=Your Exact Tally Company Name
# TALLY_VOUCHER_TYPE=Purchase
# TALLY_VOUCHER_CLASS=Automated Purchase
