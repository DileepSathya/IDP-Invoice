## Copy this file to `.env` and fill in values.
## Do NOT commit `.env`.

# Required
GEMINI_API_KEY=YOUR_KEY_HERE

# Optional
GEMINI_MODEL=gemini-2.5-flash

# Prompt template. `{ocr_text}` will be replaced with OCR output.
GEMINI_PROMPT=Extract structured invoice data from the OCR text below.\n\nReturn STRICT JSON ONLY (no markdown, no explanations).\n\nRequired top-level keys (always include; use null if missing):\n- invoice_number\n- invoice_date\n- due_date\n- seller\n- buyer\n- address\n- bank_name\n- bank_address\n- account_number\n- account_holder_name\n- ifsc_code\n- total_amount\n\nLine items:\n- line_items: an array (can be empty [])\n- Each item must be its own NEW array element (do NOT embed multiple services/HSN in one string/object)\n- Each line item object keys (use null if missing):\n  - hsn_number\n  - service\n  - quantity\n  - price_per_unit\n  - amount\n\nRules:\n- If a field is not present return null\n- If there are multiple HSN numbers or services, create multiple objects inside line_items\n- Numbers can be strings if OCR is ambiguous\n- Add any extra fields you find into: additional_fields (object). If none, use {}.\n- Output MUST be valid JSON\n\nOCR TEXT:\n{ocr_text}

# MongoDB (optional, defaults shown)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=IDP
MONGO_INVOICES_COLLECTION=invoices

# Invoice file lifecycle folders (optional — all relative to app install root)
TO_BE_PROCESSED_DIR=./invoices_data/to_be_processed
API_STAGING_DIR=./invoices_data/_api_staging
HITL_PENDING_DIR=./invoices_data/HITL_pending
ERROR_DIR=./invoices_data/ERROR
GEMINI_API_ERROR_DIR=./invoices_data/gemini_api_error
COMPLETED_DIR=./invoices_data/Completed

# Chatbot — Qdrant + embeddings for semantic search; structured MongoDB analytics;
# optional Gemini for natural-language answers when GEMINI_API_KEY is set
# Set CHAT_OFFLINE_ONLY=true to disable Gemini and answer fully offline
# CHAT_OFFLINE_ONLY=false
# GEMINI_CHAT_PROMPT=Answer using only this invoice context.\n\nContext:\n{context}\n\nQuestion: {question}

# Vector search backend: qdrant (default) or tfidf (legacy local fallback)
# CHAT_VECTOR_BACKEND=qdrant
# CHAT_EMBEDDING_PROVIDER=auto
# CHAT_EMBEDDING_PREFER_GEMINI=false
# CHAT_EMBEDDING_FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# GEMINI_EMBEDDING_MODEL=text-embedding-004
# QDRANT_URL=
# QDRANT_PATH=
# QDRANT_COLLECTION=idp_invoices
# QDRANT_API_KEY=

# Portable / packaged app (optional)
IDP_API_PORT=8000
# Set to 0/false to skip bundled MongoDB and use your own server (e.g. Atlas)
IDP_USE_BUNDLED_MONGO=1
