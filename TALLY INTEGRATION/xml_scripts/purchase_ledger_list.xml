<ENVELOPE>
    <HEADER>
        <VERSION>1</VERSION>
        <TALLYREQUEST>Export</TALLYREQUEST>
        <TYPE>COLLECTION</TYPE>
        <ID>PurchaseLedgerCollection</ID>
    </HEADER>
    <BODY>
        <DESC>
            <STATICVARIABLES>
                <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
            </STATICVARIABLES>
            <TDL>
                <TDLMESSAGE>
                    <COLLECTION NAME="PurchaseLedgerCollection">
                        <TYPE>Ledger</TYPE>
                        <FETCH>Name</FETCH>
                        <FILTER>PurchaseLedgerFilter</FILTER>
                    </COLLECTION>
                    <SYSTEM TYPE="Formulae" NAME="PurchaseLedgerFilter">
                        $$IsLedOfGrp:$Name:$$GroupPurchaseAccounts
                    </SYSTEM>
                </TDLMESSAGE>
            </TDL>
        </DESC>
    </BODY>
</ENVELOPE>
